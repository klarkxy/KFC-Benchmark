/**
 * Generates the browser-playable scenario bundles under site/public/scenarios/.
 *
 * Run from the repo root (no `pnpm -r build` needed: every workspace package
 * resolves through its exports map to `src/`, which tsx loads directly):
 *
 *     pnpm exec tsx site/scripts/gen-scenarios.mts
 *
 * Output (committed, and regenerated by the pages workflow):
 *   scenarios/index.json      scenario picker index (labels + reference scores)
 *   scenarios/<tier>.json     full bundle: PublicConfig + materialized orders
 *
 * Each bundle also carries the score the greedy baseline achieves on the SAME
 * public practice stream with the SAME policy seed the game uses, so the play
 * page can show "beat the bot" without shipping any submission code to the
 * browser. Output is fully deterministic: no wall-clock, no randomness beyond
 * the seeded pipeline.
 */
import { mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

import { runScenario } from "@kitchensched/core";
import { isControllerModule, type ControllerModule, type Order, type PublicConfig } from "@kitchensched/contracts";
import { materializeOrders, validateScenario, type OrderStreamFile } from "@kitchensched/scen";

const HERE = dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = join(HERE, "..", "..");
const SCENARIOS_DIR = join(REPO_ROOT, "scenarios");
const GREEDY_PATH = join(REPO_ROOT, "submissions", "baselines", "greedy", "submission.ts");
const OUT_ROOT = join(HERE, "..", "public", "scenarios");

/** Fixed policy seed for human game sessions and their reference runs. */
const GAME_POLICY_SEED = 42;

const DIFFICULTY_LABELS: Record<string, string> = {
  easy: "新手厨房",
  medium: "标准厨房",
  complex: "复杂厨房",
};

async function loadGreedy(): Promise<ControllerModule> {
  const mod: unknown = await import(pathToFileURL(GREEDY_PATH).href);
  if (!isControllerModule(mod)) {
    throw new Error("greedy baseline does not satisfy ControllerModule");
  }
  const exported = (mod as { default?: unknown }).default;
  return (exported ?? mod) as ControllerModule;
}

interface BundleMeta {
  tier: string;
  label: string;
  difficulty: string;
  scenario_id: string;
  end_at_ms: number;
  station_count: number;
  order_count: number;
  book_value_minor: number;
  greedy_score_minor: number;
  url: string;
}

async function buildTier(tier: string, greedy: ControllerModule): Promise<BundleMeta> {
  const dir = join(SCENARIOS_DIR, tier);
  const config = JSON.parse(readFileSync(join(dir, "kitchen.json"), "utf8")) as PublicConfig;
  const stream = JSON.parse(readFileSync(join(dir, "practice-stream.json"), "utf8")) as OrderStreamFile;

  const issues = validateScenario(config, stream);
  if (issues.length > 0) {
    throw new Error(`scenarios/${tier} fails validation: ${issues.map((i) => i.message).join("; ")}`);
  }

  const orders: Order[] = materializeOrders(config, stream);
  const book_value_minor = orders.reduce((sum, order) => sum + order.value_minor, 0);

  const out = runScenario({
    config,
    orderStream: orders,
    controller: greedy,
    policy_seed: GAME_POLICY_SEED,
  });
  if (out.result.status !== "completed" || out.result.score_minor === null) {
    throw new Error(
      `greedy reference run failed on ${tier}: status=${out.result.status} failure=${out.result.failure_code ?? "none"}`,
    );
  }

  const bundle = {
    schema: "kitchensched-scenario/1",
    tier,
    config,
    orders,
    stream: {
      visibility: "public",
      tag: "practice",
      seed: stream.seed,
      generator_version: stream.generator_version,
    },
    policy_seed: GAME_POLICY_SEED,
    reference: {
      greedy_score_minor: out.result.score_minor,
      book_value_minor,
    },
  };
  writeFileSync(join(OUT_ROOT, `${tier}.json`), `${JSON.stringify(bundle, null, 2)}\n`);

  return {
    tier,
    label: DIFFICULTY_LABELS[config.difficulty] ?? config.scenario_id,
    difficulty: config.difficulty,
    scenario_id: config.scenario_id,
    end_at_ms: config.end_at_ms,
    station_count: config.stations.length,
    order_count: orders.length,
    book_value_minor,
    greedy_score_minor: out.result.score_minor,
    url: `${tier}.json`,
  };
}

async function main(): Promise<void> {
  mkdirSync(OUT_ROOT, { recursive: true });
  const tiers = readdirSync(SCENARIOS_DIR, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name)
    .filter((name) => {
      try {
        readdirSync(join(SCENARIOS_DIR, name));
        return true;
      } catch {
        return false;
      }
    })
    .sort();

  const greedy = await loadGreedy();
  const scenarios: BundleMeta[] = [];
  for (const tier of tiers) {
    scenarios.push(await buildTier(tier, greedy));
  }

  const index = {
    schema: "kitchensched-scenarios/1",
    scenarios,
  };
  writeFileSync(join(OUT_ROOT, "index.json"), `${JSON.stringify(index, null, 2)}\n`);

  for (const meta of scenarios) {
    console.log(
      `${meta.tier}: ${meta.order_count} orders, book=${meta.book_value_minor}, greedy=${meta.greedy_score_minor}`,
    );
  }
}

await main();
